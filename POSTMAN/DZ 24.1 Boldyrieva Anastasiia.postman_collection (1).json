	"item": [
		{
			"name": "New user registration",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"pm.globals.set(\"Password\", \"Qwerty123\");//створити глобальну зміну",
							"",
							"pm.globals.set(\"Email\", pm.variables.replaceIn(\"{{$randomEmail}}\"))"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"pm.test(\"Check the currency after registration - USD\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data.currency).to.eql(\"usd\");",
							"});",
							"pm.test(\"Check the distance units after registration - km\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data.distanceUnits).to.eql(\"km\");",
							"});",
							";"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"auth": {
					"type": "noauth"
				},
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"John\",\n  \"lastName\": \"Dou\",\n  \"email\": \"{{Email}}\",\n  \"password\": \"{{Password}}\",\n  \"repeatPassword\": \"{{Password}}\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
